# Python bytecode and native build artifacts
__pycache__/
*.py[cod]
*.pyd
*.so
*.dll

# Virtual environments
.venv/
venv/
env/
ENV/

# Editors and IDEs
.vscode/
.idea/
*.iml
*~
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temporary files
*.log
*.tmp
