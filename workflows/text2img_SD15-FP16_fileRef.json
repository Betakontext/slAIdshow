{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors" },
    "_meta": { "title": "Load Checkpoint (SD1.5 FP16)" }
  },
  "2": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "", "clip": ["1", 1] },
    "_meta": { "title": "CLIP Text Encode (Positive)" }
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "text, watermark, logo, low quality, blurry, bad anatomy", "clip": ["1", 1] },
    "_meta": { "title": "CLIP Text Encode (Negative)" }
  },
  "4": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 512, "height": 512, "batch_size": 1 },
    "_meta": { "title": "Empty Latent Image (Base Size)" }
  },
  "8": {
    "class_type": "LoadImage",
    "inputs": { "image": "PLACEHOLDER.png" },
    "_meta": { "title": "Load Image (Reference)" }
  },
  "9": {
    "class_type": "VAEEncode",
    "inputs": { "pixels": ["8", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Encode (Ref → Latents)" }
  },
  "5": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 123456789,
      "steps": 20,
      "cfg": 8.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 0.55,
      "model": ["1", 0],
      "positive": ["2", 0],
      "negative": ["3", 0],
      "latent_image": ["9", 0]
    },
    "_meta": { "title": "KSampler (Ref-guided)" }
  },
  "6": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["5", 0], "vae": ["1", 2] },
    "_meta": { "title": "VAE Decode" }
  },
  "7": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "ComfyUI", "images": ["6", 0] },
    "_meta": { "title": "Save Image" }
  }
}
